!include ../galera_2nodes_as_slave.cnf

[mysqld]
wsrep-debug=1

[mysqld.1]
wsrep_gtid_mode=1
wsrep_gtid_domain_id=16
gtid_domain_id=11
gtid_strict_mode=1
# Galera appliers and async replication workers both run multi threaded,
# which is the configuration the problem was reported in.
wsrep-slave-threads=4
slave-parallel-threads=4
slave-parallel-mode=aggressive

[mysqld.2]
wsrep_gtid_mode=1
wsrep_gtid_domain_id=16
gtid_domain_id=11
gtid_strict_mode=1
wsrep-slave-threads=4

[mysqld.3]
gtid_domain_id=3
