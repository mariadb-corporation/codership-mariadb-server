#
# MGL-301: local commit is rolled back when its BF-abort victim cannot
#          enter the local monitor and must "replay". The victim is
#          guaranteed to fail certification (cert. window > 16K)
#
# STEPS:
# 1. Hold node_2 appliers and disable flow control on it
# 2. Open a local trx on node_2 that locks a row, stop it before replication
# 3. Queue 70000 writesets from node_1 behind a conflicting one
# 4. Let the local trx replicate, it lands out of the local monitor window
# 5. Release the appliers: the earlier conflicting writeset from node_1
#    BF-aborts the local trx. The victim is out of the local monitor's
#    process_ window, so it is only reachable through the monitor's dynamic
#    overflow registry (MGL-301) rather than the normal in-window path. By
#    the time it gets to replay, its certification interval exceeds
#    cert.max_length, so certification itself now refuses it outright --
#    same end result as MGL-301-reject.test (trx rolled back, node stays in
#    the cluster), just for a different reason.
# 6. Check the backlog drains and node_2 resumes normal operation.
#

--source include/galera_cluster.inc
--source include/big_test.inc
--source include/galera_have_debug_sync.inc

--let $node_1=node_1
--let $node_2=node_2
--source include/auto_increment_offset_save.inc

--connection node_1
call mtr.add_suppression("WSREP: certification interval");
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0);
CREATE TABLE t2 (id INT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=InnoDB;
--delimiter |
CREATE PROCEDURE fill(n INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  WHILE i < n DO
    INSERT INTO t2 (v) VALUES (i);
    SET i = i + 1;
  END WHILE;
END|
--delimiter ;

--connection node_2
call mtr.add_suppression("WSREP: certification interval");
SET SESSION wsrep_sync_wait=0;
SET GLOBAL wsrep_provider_options='gcs.fc_limit=1000000';

--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2
--connection node_2a
SET SESSION wsrep_sync_wait=0;
BEGIN;
UPDATE t1 SET v = 100 WHERE id = 1;

--connection node_2
SET GLOBAL wsrep_provider_options='dbug=d,apply_monitor_slave_enter_sync,before_replicate_sync';

--connection node_2a
--send COMMIT

--connection node_1
UPDATE t1 SET v = 1 WHERE id = 1;

--connection node_2
SET SESSION wsrep_on=OFF;
--let $wait_condition = SELECT VARIABLE_VALUE LIKE '%apply_monitor_slave_enter_sync%' AND VARIABLE_VALUE LIKE '%before_replicate_sync%' FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_debug_sync_waiters'
--source include/wait_condition.inc
SET SESSION wsrep_on=ON;

--connection node_1
CALL fill(70000);

--connection node_2
SET SESSION wsrep_on=OFF;
--let $wait_condition = SELECT VARIABLE_VALUE >= 40000 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_local_recv_queue'
--source include/wait_condition.inc
SET SESSION wsrep_on=ON;

# Let the local trx replicate, it gets a seqno far ahead of the monitor
SET GLOBAL wsrep_provider_options='signal=before_replicate_sync';
--sleep 10

# Raise wsrep_slave_threads before releasing the appliers: node_2a's commit
# cannot return until its replay enters the local monitor, which means the
# whole backlog has to be certified first. With a single applier thread that
# alone takes longer than a typical testcase timeout on a debug build. The
# out-of-window condition this test relies on is already established at this
# point, so applying the (independent, non-conflicting) backlog in parallel
# does not affect it.
SET GLOBAL wsrep_slave_threads = 16;

# Release the appliers. The conflicting writeset from node_1 (queued ahead
# of the backlog) can now proceed, BF-aborting node_2a's trx. Node_2 must
# not abort: the victim's commit must simply fail.
SET GLOBAL wsrep_provider_options='dbug=';
SET GLOBAL wsrep_provider_options='signal=apply_monitor_slave_enter_sync';

--connection node_2a
--error ER_LOCK_DEADLOCK
--reap

# Node must still be a fully functional member of the cluster.
--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--connection node_2
SELECT VARIABLE_VALUE = 'ON' FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_connected';

# Let the rest of the backlog drain.
SET SESSION wsrep_on=OFF;
--let $wait_timeout = 120
--let $wait_condition = SELECT COUNT(*) = 70000 FROM t2
--source include/wait_condition.inc
SET SESSION wsrep_on=ON;
SET GLOBAL wsrep_slave_threads = 1;

# node_1's update was ordered first and must have won; node_2a's conflicting
# update must have been rolled back rather than applied.
--let $wait_condition = SELECT v = 1 FROM t1 WHERE id = 1
--source include/wait_condition.inc

--connection node_2a
SELECT v FROM t1 WHERE id = 1;

--disconnect node_2a

--connection node_1
DROP PROCEDURE fill;
DROP TABLE t1, t2;

--source include/auto_increment_offset_restore.inc
