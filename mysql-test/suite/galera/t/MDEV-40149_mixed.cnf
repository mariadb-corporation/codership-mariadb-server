!include ../galera_2nodes_as_slave.cnf

[mysqld]
wsrep-debug=1

[mysqld.1]
wsrep_gtid_mode=1
wsrep_gtid_domain_id=16
gtid_domain_id=11
gtid_strict_mode=1
# Both nodes take turns as the async replica, so both need multi threaded
# async apply as well as multi threaded Galera apply.
wsrep-slave-threads=4
slave-parallel-threads=4
slave-parallel-mode=aggressive

[mysqld.2]
wsrep_gtid_mode=1
wsrep_gtid_domain_id=16
gtid_domain_id=11
gtid_strict_mode=1
# Both nodes take turns as the async replica, so both need multi threaded
# async apply as well as multi threaded Galera apply.
wsrep-slave-threads=4
slave-parallel-threads=4
slave-parallel-mode=aggressive

[mysqld.3]
gtid_domain_id=3
