--source include/galera_cluster.inc
--source include/have_innodb.inc

--echo #
--echo # MDEV-42327: the same bug shape as the GRANT ... ON <table> fix, in
--echo # mysql_grant_role() (GRANT <role> TO <user> IDENTIFIED BY ...): the
--echo # implicit account-creation/password-change path there ran
--echo # check_alter_user() and test_if_create_new_users() after TOI too.
--echo #

--connection node_1
CREATE ROLE role5;
CREATE USER u5;
CREATE USER victim5;
GRANT role5 TO u5 WITH ADMIN OPTION;

--echo #
--echo # check_alter_user(): u5 has ADMIN OPTION on role5, but not UPDATE on
--echo # mysql.*, so it must not be able to change another, existing
--echo # account's password while granting the role to it.
--echo #
--connect(g1,127.0.0.1,u5,,,$NODE_MYPORT_1)
--error ER_DBACCESS_DENIED_ERROR
GRANT role5 TO victim5 IDENTIFIED BY 'newpass';
--disconnect g1

--connection node_2
--let $priv = query_get_value(SELECT COUNT(*) AS c FROM mysql.roles_mapping WHERE User = 'victim5', c, 1)
if ($priv)
{
  --die Node 2 applied the GRANT that node 1 refused (check_alter_user): victim5 holds role5 there
}
--disable_query_log
--error ER_ACCESS_DENIED_ERROR
--connect(g1v,127.0.0.1,victim5,newpass,,$NODE_MYPORT_2)
--enable_query_log

--echo #
--echo # Positive case: UPDATE ON mysql.* lets the same kind of account
--echo # change another account's password via a role GRANT; it must
--echo # succeed and replicate, including the new password.
--echo #
--connection node_1
GRANT UPDATE ON mysql.* TO u5;
--connect(g2,127.0.0.1,u5,,,$NODE_MYPORT_1)
GRANT role5 TO victim5 IDENTIFIED BY 'newpass';
--disconnect g2

--connection node_2
--let $priv = query_get_value(SELECT COUNT(*) AS c FROM mysql.roles_mapping WHERE User = 'victim5', c, 1)
if (!$priv)
{
  --die Node 2 did not apply the GRANT that node 1 accepted: victim5 should hold role5 there
}
--connect(g2v,127.0.0.1,victim5,newpass,,$NODE_MYPORT_2)
SELECT CURRENT_USER();
--disconnect g2v

--connection node_1
REVOKE UPDATE ON mysql.* FROM u5;

--echo #
--echo # test_if_create_new_users(): the same account must not be able to
--echo # create a brand new account via a role GRANT.
--echo #
--connect(g3,127.0.0.1,u5,,,$NODE_MYPORT_1)
--error ER_CANT_CREATE_USER_WITH_GRANT
GRANT role5 TO brand_new_user7 IDENTIFIED BY 'x';
--disconnect g3

--connection node_2
--let $exists = query_get_value(SELECT COUNT(*) AS c FROM mysql.user WHERE User = 'brand_new_user7', c, 1)
if ($exists)
{
  --die Node 2 applied the GRANT that node 1 refused (test_if_create_new_users): brand_new_user7 was created there
}

--echo #
--echo # Positive case: CREATE USER lets the same kind of account create a
--echo # brand new account via a role GRANT; it must succeed and
--echo # replicate.
--echo #
--connection node_1
GRANT CREATE USER ON *.* TO u5;
--connect(g4,127.0.0.1,u5,,,$NODE_MYPORT_1)
GRANT role5 TO brand_new_user8 IDENTIFIED BY 'y';
--disconnect g4

--connection node_2
--let $exists = query_get_value(SELECT COUNT(*) AS c FROM mysql.user WHERE User = 'brand_new_user8', c, 1)
if (!$exists)
{
  --die Node 2 did not apply the GRANT that node 1 accepted: brand_new_user8 should exist there
}

--connection node_1
REVOKE CREATE USER ON *.* FROM u5;
DROP ROLE role5;
DROP USER u5;
DROP USER victim5;
DROP USER brand_new_user8;

--source include/galera_end.inc
--echo # End of test
