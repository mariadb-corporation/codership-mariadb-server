#
# MDEV-40149: one Galera node feeding a single GTID domain from both async
# replication and Galera write sets.
#
# The two paths publish a position into the same rpl_slave_state domain but
# allocate their recency value (list_element::order_id) at different points:
#
#   - async replication uses the sub_id that event_group_new_gtid() takes in
#     the SQL driver thread, in relay log order
#   - a Galera applier takes a separate order_id in
#     wsrep_gtid_slave_pos_publish(), under commit order, because its sub_id
#     is allocated when the GTID event is parsed and appliers parse in
#     parallel
#
# Both come from rpl_slave_state::next_sub_id(), which is a single ++counter
# under LOCK_slave_state, so the values cannot collide. update_nolock() has a
# debug assertion for that; this test exists to drive both paths into one
# domain on one node so the assertion is actually exercised.
#
# A replica failover between the two Galera nodes produces the mixed state on
# both of them:
#
#   phase 1   primary --async--> node_1 --galera--> node_2
#             node_1: domain 3 via async, node_2: domain 3 via write sets
#
#   phase 2   primary --async--> node_2 --galera--> node_1
#             the two roles swap, so each node now holds domain 3 entries
#             produced by both paths
#
# Phase 2 also depends on the fix functionally: node_2 can only pick up the
# stream at the right place if the position it recorded while applying write
# sets in phase 1 is correct. A position that lagged by one would re-apply an
# already applied event and fail under gtid_strict_mode.
#
--source include/have_innodb.inc
--source include/have_log_bin.inc
--source include/galera_cluster.inc

--connect primary, 127.0.0.1, root, , test, $NODE_MYPORT_3

#
# mysql.gtid_slave_pos is Aria after an MTR bootstrap, but InnoDB in a real
# installation where InnoDB is available. Both engines have to work: with
# InnoDB the position row is written inside the applying transaction and is
# only visible to others as a dirty read until that transaction commits,
# with Aria it is written non-transactionally and visible at once. On the
# Galera nodes the ALTER is a TOI so it reaches the whole cluster.
#
# The async masters are deliberately left alone: they never record a
# slave position, and the DDL would sit in their binlog and be replayed
# into the cluster, making an applier alter mysql.gtid_slave_pos while
# store_gtid_event() is writing to it.
#
if ($MTR_COMBINATION_INNODB)
{
  --disable_query_log
  --disable_result_log
  --connection node_1
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
  --connection node_2
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
  #
  # These are not Galera nodes. Keep the DDL out of their binlog: on an
  # async master it would be replayed into the cluster, making an applier
  # alter mysql.gtid_slave_pos while store_gtid_event() writes to it, and
  # on the leaf slave it would add a domain the aria combination lacks.
  #
  --connection primary
  SET SESSION sql_log_bin = 0;
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
  SET SESSION sql_log_bin = 1;

  #
  # Do not go on until every server really has the new engine.
  # wait_condition.inc finishes with --enable_query_log, so the query
  # log has to be turned off again after each one, otherwise the
  # --connection lines below would reach the result and the aria
  # combination, which skips this block, would no longer match.
  #
  --let $wait_condition = SELECT COUNT(*) = 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'mysql' AND TABLE_NAME = 'gtid_slave_pos' AND ENGINE = 'InnoDB';
  --connection node_1
  --source include/wait_condition.inc
  --disable_query_log
  --connection node_2
  --source include/wait_condition.inc
  --disable_query_log
  --connection primary
  --source include/wait_condition.inc
  --disable_query_log
  --enable_result_log
  --enable_query_log
}

--echo # mysql.gtid_slave_pos engine is the one this combination asks for
--let $expected_engine= Aria
if ($MTR_COMBINATION_INNODB)
{
  --let $expected_engine= InnoDB
}
--connection node_1
--disable_query_log
--eval SELECT ENGINE = '$expected_engine' AS EXPECT_1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'mysql' AND TABLE_NAME = 'gtid_slave_pos'
--enable_query_log
--connection node_2
--disable_query_log
--eval SELECT ENGINE = '$expected_engine' AS EXPECT_1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'mysql' AND TABLE_NAME = 'gtid_slave_pos'
--enable_query_log
--connection primary
--disable_query_log
--eval SELECT ENGINE = '$expected_engine' AS EXPECT_1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'mysql' AND TABLE_NAME = 'gtid_slave_pos'
--enable_query_log

--echo # Both nodes apply asynchronously and via Galera with several threads,
--echo # so both parallelisms are active whichever node holds the async stream
--connection node_1
SELECT @@wsrep_slave_threads > 1 AS EXPECT_1, @@slave_parallel_threads > 1 AS EXPECT_1;
--connection node_2
SELECT @@wsrep_slave_threads > 1 AS EXPECT_1, @@slave_parallel_threads > 1 AS EXPECT_1;

--echo #
--echo # Phase 1: node_1 is the async replica, node_2 only applies write sets
--echo #
--connection node_1
--disable_query_log
--eval CHANGE MASTER TO master_host='127.0.0.1', master_user='root', master_port=$NODE_MYPORT_3, master_use_gtid=slave_pos;
--enable_query_log
START SLAVE;

--connection primary
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY AUTO_INCREMENT, f2 INTEGER) ENGINE=InnoDB;
--disable_query_log
--let $count= 0
while ($count < 200)
{
  --eval INSERT INTO t1 VALUES (NULL, $count)
  --inc $count
}
--enable_query_log
--let $primary_pos_1= `SELECT @@gtid_binlog_pos`

--connection node_1
--let $wait_condition = SELECT COUNT(*) = 200 FROM t1;
--source include/wait_condition.inc
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 200 FROM t1;
--source include/wait_condition.inc

--echo # Both nodes agree with the primary after phase 1
--connection node_1
--disable_query_log
--eval SELECT @@gtid_slave_pos = '$primary_pos_1' AS EXPECT_1
--enable_query_log
--connection node_2
--let $wait_condition = SELECT @@gtid_slave_pos = '$primary_pos_1';
--source include/wait_condition.inc
--disable_query_log
--eval SELECT @@gtid_slave_pos = '$primary_pos_1' AS EXPECT_1
--enable_query_log

--echo #
--echo # Phase 2: fail the async stream over to node_2. Its domain 3 position
--echo # comes from write sets applied in phase 1, so START SLAVE resumes from
--echo # there. node_1 now receives domain 3 as write sets instead.
--echo #
--connection node_1
STOP SLAVE;
RESET SLAVE ALL;

--connection node_2
--disable_query_log
--eval CHANGE MASTER TO master_host='127.0.0.1', master_user='root', master_port=$NODE_MYPORT_3, master_use_gtid=slave_pos;
--enable_query_log
START SLAVE;

--connection primary
--disable_query_log
--let $count= 0
while ($count < 200)
{
  --eval INSERT INTO t1 VALUES (NULL, 1000 + $count)
  --inc $count
}
--enable_query_log
--let $primary_pos_2= `SELECT @@gtid_binlog_pos`

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 400 FROM t1;
--source include/wait_condition.inc
--connection node_1
--let $wait_condition = SELECT COUNT(*) = 400 FROM t1;
--source include/wait_condition.inc

--echo # No event was applied twice and none was skipped
--connection primary
SELECT COUNT(*) AS EXPECT_400 FROM t1;
--connection node_1
SELECT COUNT(*) AS EXPECT_400 FROM t1;
--connection node_2
SELECT COUNT(*) AS EXPECT_400 FROM t1;

--echo # Both nodes agree with the primary after the failover, each having
--echo # recorded domain 3 through both paths
--connection node_2
--let $wait_condition = SELECT @@gtid_slave_pos = '$primary_pos_2';
--source include/wait_condition.inc
--disable_query_log
--eval SELECT @@gtid_slave_pos = '$primary_pos_2' AS EXPECT_1
--enable_query_log
--connection node_1
--let $wait_condition = SELECT @@gtid_slave_pos = '$primary_pos_2';
--source include/wait_condition.inc
--disable_query_log
--eval SELECT @@gtid_slave_pos = '$primary_pos_2' AS EXPECT_1
--enable_query_log

--echo # mysql.gtid_slave_pos is still being pruned on both nodes. Rows are
--echo # deleted by sub_id, so this would grow without bound if order_id had
--echo # been used as the row key instead of only as the recency value.
--connection node_1
SELECT COUNT(*) > 0 AND COUNT(*) < 400 AS EXPECT_1 FROM mysql.gtid_slave_pos;
--connection node_2
SELECT COUNT(*) > 0 AND COUNT(*) < 400 AS EXPECT_1 FROM mysql.gtid_slave_pos;

#
# Cleanup
#
--connection primary
DROP TABLE t1;

--connection node_1
--let $wait_condition = SELECT COUNT(*) = 0 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
--source include/wait_condition.inc
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 0 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1';
--source include/wait_condition.inc

--connection node_2
STOP SLAVE;
RESET SLAVE ALL;
SET GLOBAL wsrep_on = OFF;
RESET MASTER;
SET GLOBAL wsrep_on = ON;
SET GLOBAL gtid_slave_pos = "";

--connection node_1
SET GLOBAL wsrep_on = OFF;
RESET MASTER;
SET GLOBAL wsrep_on = ON;
SET GLOBAL gtid_slave_pos = "";

--connection primary
RESET MASTER;

--connection node_1
--disconnect primary

--source include/galera_end.inc
--echo # End of test
