connection node_2;
connection node_1;
#
# MDEV-42327: the same bug shape as the GRANT ... ON <table> fix,
# in mysql_grant() (GRANT ... ON <db>.* / *.*): TOI used to start
# in the caller, before mysql_grant() opened the grant tables, so
# check_alter_user() and test_if_create_new_users() both ran
# after TOI too.
#
connection node_1;
CREATE DATABASE db4;
CREATE USER u4;
CREATE USER victim4;
GRANT SELECT ON db4.* TO u4 WITH GRANT OPTION;
#
# check_alter_user(): u4 has a grant option on the database, but not
# UPDATE on mysql.*, so it must not be able to change another,
# existing account's password.
#
connect d1,127.0.0.1,u4,,,$NODE_MYPORT_1;
GRANT SELECT ON db4.* TO victim4 IDENTIFIED BY 'newpass';
ERROR 42000: Access denied for user 'u4'@'%' to database 'mysql'
disconnect d1;
connection node_2;
ERROR 28000: Access denied for user 'victim4'@'localhost' (using password: YES)
#
# Positive case: UPDATE ON mysql.* lets the same kind of account
# change another account's password via a db-level GRANT; it must
# succeed and replicate, including the new password.
#
connection node_1;
GRANT UPDATE ON mysql.* TO u4;
connect d2,127.0.0.1,u4,,,$NODE_MYPORT_1;
GRANT SELECT ON db4.* TO victim4 IDENTIFIED BY 'newpass';
disconnect d2;
connection node_2;
connect d2v,127.0.0.1,victim4,newpass,,$NODE_MYPORT_2;
SELECT CURRENT_USER();
CURRENT_USER()
victim4@%
disconnect d2v;
connection node_1;
REVOKE UPDATE ON mysql.* FROM u4;
#
# test_if_create_new_users(): the same account must not be able to
# create a brand new account via a db-level GRANT.
#
connect d3,127.0.0.1,u4,,,$NODE_MYPORT_1;
GRANT SELECT ON db4.* TO brand_new_user5 IDENTIFIED BY 'x';
ERROR 42000: You are not allowed to create a user with GRANT
disconnect d3;
connection node_2;
#
# Positive case: CREATE USER lets the same kind of account create a
# brand new account via a db-level GRANT; it must succeed and
# replicate.
#
connection node_1;
GRANT CREATE USER ON *.* TO u4;
connect d4,127.0.0.1,u4,,,$NODE_MYPORT_1;
GRANT SELECT ON db4.* TO brand_new_user6 IDENTIFIED BY 'y';
disconnect d4;
connection node_2;
connection node_1;
REVOKE CREATE USER ON *.* FROM u4;
DROP DATABASE db4;
DROP USER u4;
DROP USER victim4;
DROP USER brand_new_user6;
disconnect node_2;
disconnect node_1;
# End of test
